# Copy to .env.local for development. Never commit real values.

# Stickers database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=stickerstore
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=StickerStore
# Set to "required" to connect over TLS.
MYSQL_SSL_MODE=disabled
MYSQL_POOL_SIZE=10

# MyBB forum database (read-only). Host/credentials default to the MYSQL_* values.
MYBB_DATABASE=mybbdb
# Forum users table; MyBB prefixes table names (stock prefix: mybb_).
MYBB_USERS_TABLE=mybb_users
# MYBB_MYSQL_HOST=
# MYBB_MYSQL_USERNAME=
# MYBB_MYSQL_PASSWORD=

# Signs login session cookies (HS256). At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Public origin of the site, e.g. https://stickers.example.com. Used to reject
# cross-site mutations; defaults to the request's Host / X-Forwarded-Host.
# APP_ORIGIN=
# Set to true behind a reverse proxy that sets X-Forwarded-For (login rate limiting).
# TRUST_PROXY=true
# Production cookies are Secure; set to true only to test a production build over plain HTTP.
# SESSION_COOKIE_INSECURE=true

# Bearer token for POST /api/v1/external/pack_grants
PACK_GRANT_API_TOKEN=change-me

# Cloudinary: cloud name is public; CLOUDINARY_URL holds the API secret (server only)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_URL=cloudinary://api_key:api_secret@your-cloud-name
