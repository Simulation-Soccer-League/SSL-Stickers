{
  "name": "ssl-stickers",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "types:check": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:schema:dump": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.local scripts/db-schema.ts dump",
    "db:schema:load": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.local scripts/db-schema.ts load",
    "db:delete-unlinked-users": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.local scripts/delete-unlinked-users.ts",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "next build && node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.local --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "db:seed": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.local scripts/db-seed.ts",
    "cloudinary:export": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.local scripts/cloudinary-export.ts",
    "cards:build-upload-zips": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.local scripts/build-upload-zips.ts"
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.3",
    "@cloudinary/url-gen": "^1.22.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/x-data-grid": "^8.22.1",
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "motion": "^12.23.26",
    "mysql2": "3.24.5",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "typescript": "~5.9.3"
  }
}
